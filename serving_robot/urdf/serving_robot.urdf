<?xml version="1.0"?>
<robot name="serving_robot">
  <!-- Generic dimensions only. Replace with measured robot dimensions before navigation tuning. -->
  <link name="base_link">
    <visual><geometry><box size="0.50 0.42 0.25"/></geometry></visual>
    <collision><geometry><box size="0.50 0.42 0.25"/></geometry></collision>
    <inertial><mass value="30.0"/><inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/></inertial>
  </link>

  <link name="left_wheel"><visual><geometry><cylinder radius="0.0762" length="0.04"/></geometry></visual><collision><geometry><cylinder radius="0.0762" length="0.04"/></geometry></collision></link>
  <link name="right_wheel"><visual><geometry><cylinder radius="0.0762" length="0.04"/></geometry></visual><collision><geometry><cylinder radius="0.0762" length="0.04"/></geometry></collision></link>
  <link name="laser"><visual><geometry><cylinder radius="0.04" length="0.05"/></geometry></visual></link>
  <link name="imu"><visual><geometry><box size="0.04 0.04 0.02"/></geometry></visual></link>

  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 0.19 0" rpy="0 1.5708 0"/><axis xyz="0 0 1"/></joint>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.19 0" rpy="0 1.5708 0"/><axis xyz="0 0 1"/></joint>
  <joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser"/><origin xyz="0.20 0 0.22" rpy="0 0 0"/></joint>
  <joint name="imu_joint" type="fixed"><parent link="base_link"/><child link="imu"/><origin xyz="0 0 0.16" rpy="0 0 0"/></joint>
</robot>
